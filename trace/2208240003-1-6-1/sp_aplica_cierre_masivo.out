insert into acl_entrada_bitacora(pky_entrada_bitacora, descripcion, fechahora, folio_csuac, fky_accion, fky_aclaracion, fky_area, fky_estatus_aclaracion, fky_estatus_corp_analisis, fky_estatus_corp_general, fky_usuario)
  values (entrada_bitacora_seq.nextval, vdescripcionaccion, current year to fraction(3), vfoliocsuac, vaccioniniciocierre, vidaclaracion, vareaacl, vestatusaclinicial, vestatusanainicial, vestatuscorpinicial, vidususario);
expression:(>= vestatusaclinicial, 3)
evaluates to f 
