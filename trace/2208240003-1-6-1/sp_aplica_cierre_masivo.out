    (montoprocedente) = (vimportereclamado),
    (predictamen) = (ppredictamen),
    (procede) = (pprocede),
    (fky_estatus_corp_general) = (vpredictamenestatuscorp),
    (fky_tipo_codigo_resolucion) = (presolucion)
  where (= folio_csuac, vfoliocsuac);
