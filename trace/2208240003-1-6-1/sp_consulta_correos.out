expression:(or (or (or (or (null pempresa), (= pempresa, "")), (or (null pnumcte), (= pnumcte, ""))), (or (null ptipocorreo), (= ptipocorreo, 0))), (or (null pconsulta), (= pconsulta, "")))
evaluates to f 
expression:
  (select (count *)
    from bdinteg:"informix".si_cliente
    where (= numcte, pnumcte))
evaluates to 1 ; 
