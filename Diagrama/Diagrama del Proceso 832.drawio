        <mxCell id="d6c4MA2DxYK4vHpi5IO--16" value="&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- pDictamen debe ser &#39;NP&#39; (No Procedente) o &#39;CM&#39; (Comisión)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- ptranaplica debe ser diferente de &#39;0343&#39; (no es una transacción de comisión)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- Se usa para realizar cargos a la cuenta del cliente&lt;/font&gt;&lt;/div&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" parent="ueTRLZFpQVW9d6dP3nZx-7" vertex="1" connectable="0">
