        <mxCell id="d6c4MA2DxYK4vHpi5IO--57" value="&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- Parámetros de entrada válidos:&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- p_empresa debe ser un código de empresa válido&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- p_num_credito debe ser un número de crédito existente&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- p_num_producto debe ser un código de producto válido&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- p_monto debe ser mayor que cero&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- p_folio debe ser un folio válido&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- p_sucursal debe ser un código de sucursal válido&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- p_tarjeta debe ser un número de tarjeta válido (aunque no se usa directamente en la llamada a GenMov)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- p_referencia debe ser una referencia válida (aunque no se usa directamente en la llamada a GenMov)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- Obtención de datos adicionales:&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- Se debe obtener correctamente la fecha actual ( vFecHoy ) de la tabla sd_fechas&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- Se debe obtener correctamente la divisa ( vDivisa ) de la tabla sd_maecred&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- Constantes específicas:&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- El valor &#39;20&#39; (posiblemente un tipo de movimiento)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- El valor &#39;336&#39; (posiblemente un código de transacción)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- El valor &#39;0000&#39; (posiblemente un código de usuario o sistema)&lt;/font&gt;&lt;/div&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" parent="ckqaZzlqkGDgGo35RIOs-44" vertex="1" connectable="0">
          <mxGeometry x="0.0556" y="2" relative="1" as="geometry">
            <mxPoint x="-2" y="-49" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ckqaZzlqkGDgGo35RIOs-30" value="&lt;p style=&quot;language:es-MX;margin-top:0pt;margin-bottom:0pt;margin-left:0in;&lt;br/&gt;text-indent:0in;text-align:left&quot;&gt;&lt;span style=&quot;font-size:11.0pt;font-family:&lt;br/&gt;Calibri;mso-ascii-font-family:Calibri;mso-fareast-font-family:+mn-ea;&lt;br/&gt;mso-bidi-font-family:+mn-cs;mso-ascii-theme-font:minor-latin;mso-fareast-theme-font:&lt;br/&gt;minor-fareast;mso-bidi-theme-font:minor-bidi;color:white;mso-color-index:14;&lt;br/&gt;language:es-MX;mso-style-textfill-type:solid;mso-style-textfill-fill-themecolor:&lt;br/&gt;light1;mso-style-textfill-fill-color:white;mso-style-textfill-fill-alpha:100.0%&quot;&gt;bdicred:&lt;/span&gt;&lt;span style=&quot;font-size:11.0pt;font-family:Calibri;mso-ascii-font-family:Calibri;&lt;br/&gt;mso-fareast-font-family:+mn-ea;mso-bidi-font-family:+mn-cs;mso-ascii-theme-font:&lt;br/&gt;minor-latin;mso-fareast-theme-font:minor-fareast;mso-bidi-theme-font:minor-bidi;&lt;br/&gt;color:white;mso-color-index:14;language:es-MX;mso-style-textfill-type:solid;&lt;br/&gt;mso-style-textfill-fill-themecolor:light1;mso-style-textfill-fill-color:white;&lt;br/&gt;mso-style-textfill-fill-alpha:100.0%&quot;&gt;Genmovref&lt;/span&gt;&lt;/p&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0050ef;fontColor=#ffffff;strokeColor=#001DBC;" parent="1" vertex="1">
          <mxGeometry x="770" y="740" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ckqaZzlqkGDgGo35RIOs-33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.469;entryY=-0.008;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="ckqaZzlqkGDgGo35RIOs-23" target="ckqaZzlqkGDgGo35RIOs-27" edge="1">
