        <mxCell id="d6c4MA2DxYK4vHpi5IO--138" value="&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- El indicador de límite personalizado para restricción 1 debe ser 0 ( vlimite_personalizado_rest1=0 )&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- El indicador de límite personalizado para restricción 2 debe ser 0 ( vlimite_personalizado_rest2=0 )&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- La restricción debe ser &#39;02&#39; ( vRestriccion = &#39;02&#39; )&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- Debe estar dentro del ciclo FOREACH que recorre los registros de la tabla si_plimites&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- El parámetro vActivar_Limite debe ser diferente de &#39;F&#39;&lt;/font&gt;&lt;/div&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" parent="d6c4MA2DxYK4vHpi5IO--124" vertex="1" connectable="0">
          <mxGeometry x="0.5979" y="-5" relative="1" as="geometry">
            <mxPoint x="-1" as="offset" />
          </mxGeometry>
