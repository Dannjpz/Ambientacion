        <mxCell id="d6c4MA2DxYK4vHpi5IO--35" value="&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- Validación de parámetros de entrada :&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- pfechaini no debe ser NULL ni vacío&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- pfechafin no debe ser NULL ni vacío&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- pfechafin debe ser mayor que pfechaini&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- pmonto no debe ser NULL ni vacío y debe ser mayor que 0&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- pcuenta no debe ser NULL ni vacío&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- Obtención de datos de la cuenta :&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- La cuenta debe existir en la tabla sc_maechq&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- Se debe poder obtener vgcuenta , vnum_cte , vtasa y vgTasaVar&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- vgcuenta debe ser igual a pcuenta&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- Obtención de datos del cliente :&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- El cliente debe existir en la tabla bdinteg:si_cliente&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- Se debe poder determinar si es persona física o moral ( ves_fisica )&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- Obtención de la tasa de ISR :&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- Se debe poder obtener vvalorISR de la tabla bdinteg:si_fechavalor&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- Cálculo del año base :&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- Se debe poder calcular vaniobase basado en el año de pfechafin&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- Obtención de la base exenta :&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- Se debe poder obtener vbase_excenta de la tabla sc_param&lt;/font&gt;&lt;/div&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" parent="ckqaZzlqkGDgGo35RIOs-20" vertex="1" connectable="0">
          <mxGeometry x="-0.0354" y="-2" relative="1" as="geometry">
            <mxPoint x="2" y="-2" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ckqaZzlqkGDgGo35RIOs-17" value="&lt;p style=&quot;language:es-MX;margin-top:0pt;margin-bottom:0pt;margin-left:0in;&lt;br/&gt;text-indent:0in;text-align:left&quot;&gt;&lt;span style=&quot;font-size: 11pt; font-family: Calibri;&quot;&gt;bdicheq&lt;/span&gt;&lt;span style=&quot;font-size: 11pt; font-family: Calibri;&quot;&gt;:&lt;/span&gt;&lt;span style=&quot;font-size: 11pt; font-family: Calibri;&quot;&gt;sp_calculaintaclaraciones&lt;/span&gt;&lt;/p&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0050ef;fontColor=#ffffff;strokeColor=#001DBC;" parent="1" vertex="1">
