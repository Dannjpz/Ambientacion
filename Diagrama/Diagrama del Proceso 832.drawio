        <mxCell id="d6c4MA2DxYK4vHpi5IO--92" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;Se debe haber obtenido un número de crédito válido ( v_num_credito ) a partir del número de tarjeta proporcionado:&lt;br&gt;El número de crédito no debe ser NULL:&lt;/font&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" parent="ckqaZzlqkGDgGo35RIOs-33" vertex="1" connectable="0">
          <mxGeometry x="-0.1561" y="-5" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="d6c4MA2DxYK4vHpi5IO--109" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" parent="1" source="ckqaZzlqkGDgGo35RIOs-35" target="cp3nV7i67v4XhAobEiOV-1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="-2510" y="600" />
