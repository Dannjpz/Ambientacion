        <mxCell id="d6c4MA2DxYK4vHpi5IO--89" value="&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- Se llama cuando se está procesando una quita (vIndProceso = &#39;Q&#39;)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- Se ejecuta para cada tarjeta asociada al crédito que no esté cancelada&lt;/font&gt;&lt;/div&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" parent="d6c4MA2DxYK4vHpi5IO--87" vertex="1" connectable="0">
