        <mxCell id="ueTRLZFpQVW9d6dP3nZx-6" value="&lt;div style=&quot;color: rgb(212, 212, 212); font-family: &amp;quot;JetBrains Mono&amp;quot;, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 16px; line-height: 28px; white-space: pre;&quot;&gt;&lt;div style=&quot;color: rgb(212, 212, 212); line-height: 28px;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(212, 212, 212), rgb(55, 55, 55)); background-color: transparent;&quot;&gt;bdicheq:&lt;/span&gt;&lt;span&gt;cargo_ref&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0050ef;fontColor=#ffffff;strokeColor=#001DBC;" parent="1" vertex="1">
          <mxGeometry x="2250" y="740" width="240.5" height="80" as="geometry" />
