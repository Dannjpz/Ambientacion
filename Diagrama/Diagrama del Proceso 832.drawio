        <mxCell id="d6c4MA2DxYK4vHpi5IO--86" value="&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- Se llama cuando CodRet = &quot;000&quot; (operación exitosa)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- El indicador obtenido de la tabla sd_transfun debe ser &#39;V&#39;&lt;/font&gt;&lt;/div&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" parent="d6c4MA2DxYK4vHpi5IO--85" vertex="1" connectable="0">
