              <mxPoint x="2210" y="3290" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="d6c4MA2DxYK4vHpi5IO--46" value="&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- La variable vcobracom debe ser igual a &quot;1&quot;, lo que indica que hay comisiones pendientes por cobrar.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- Esta variable puede establecerse de varias maneras:&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- Si vgencom = &quot;1&quot; , entonces vcobracom se establece a &quot;1&quot; después de llamar a gencomtran .&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- Si la transacción no es de pago de intereses, uso de CCC, abono de colocación o uso de SBG (verificado contra parámetros del sistema), y hay un saldo SBG ( vimpsbg &amp;gt; 0 ), entonces vcobracom se establece a &quot;1&quot;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- Si no se cumple ninguna de las condiciones anteriores, se verifica si hay comisiones pendientes en la tabla sc_detcomis&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- Por lo tanto, para que se llame a cobintcomsbg , debe cumplirse al menos una de estas condiciones:&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- La transacción genera comisión.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- Hay un saldo SBG positivo.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- Hay comisiones pendientes en la tabla sc_detcomis .&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- Además, la transacción no debe ser de pago de intereses, uso de CCC, abono de colocación o uso de SBG.&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;&amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" parent="d6c4MA2DxYK4vHpi5IO--34" vertex="1" connectable="0">
          <mxGeometry x="0.0759" y="-1" relative="1" as="geometry">
            <mxPoint x="813" y="-11" as="offset" />
          </mxGeometry>
        </mxCell>
