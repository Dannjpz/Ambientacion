          </mxGeometry>
        </mxCell>
        <mxCell id="d6c4MA2DxYK4vHpi5IO--136" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;La variable VNuevaLinea debe ser mayor que 0:&lt;br&gt;La variable no_movimiento debe ser igual a 0:&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Se debe haber actualizado correctamente la línea de crédito en la tabla sd_maesdos :&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Estas condiciones varían según el tipo de operación que se esté realizando:&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- Para incremento ( tipo = &#39;I&#39; )&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- Para reducción ( tipo = &#39;R&#39; )&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;- Para reactivación ( tipo = &#39;3&#39; )&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" parent="d6c4MA2DxYK4vHpi5IO--109" vertex="1" connectable="0">
          <mxGeometry x="0.5087" y="3" relative="1" as="geometry">
            <mxPoint x="1" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ckqaZzlqkGDgGo35RIOs-35" value="&lt;div style=&quot;color: rgb(212, 212, 212); font-family: &amp;quot;JetBrains Mono&amp;quot;, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 16px; line-height: 28px; white-space: pre;&quot;&gt;&lt;span&gt;&lt;span style=&quot;color: rgb(212, 212, 212);&quot;&gt;bdicred&lt;/span&gt;&lt;span style=&quot;color: rgb(212, 212, 212);&quot;&gt;:&lt;/span&gt;sp_incremento_reduccion&lt;/span&gt;&lt;/div&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0050ef;fontColor=#ffffff;strokeColor=#001DBC;" parent="1" vertex="1">
          <mxGeometry x="-2940" y="560" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="d6c4MA2DxYK4vHpi5IO--111" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" parent="1" source="ckqaZzlqkGDgGo35RIOs-36" target="d6c4MA2DxYK4vHpi5IO--110" edge="1">
